<div class="ui-skeleton-card {{@class}}" aria-hidden="true" ...attributes>
    <div class="ui-skeleton-card-header">
        <Skeleton @variant="title" @width="55%" />
        <Skeleton @variant="circle" @width="0.5rem" @height="0.5rem" />
    </div>
    {{#unless @hideMedia}}
        <div class="ui-skeleton-card-media" {{set-height this.mediaHeight}}>
            <Skeleton @variant="rect" @width="100%" @height="100%" />
        </div>
    {{/unless}}
    <div class="ui-skeleton-card-body">
        <Skeleton @variant="text" @width="70%" />
        <Skeleton @variant="text" @width="45%" />
    </div>
    <div class="ui-skeleton-card-footer">
        <Skeleton @variant="badge" />
        <span class="ui-skeleton-card-meta">
            <Skeleton @variant="text" @width="2.5rem" />
            <Skeleton @variant="text" @width="2.5rem" />
        </span>
    </div>
</div>
