<Resource::Pill
    @resource={{or @file @resource}}
    @resourceType="file"
    @title={{@title}}
    @titleFallback={{or @titleFallback "No file"}}
    @subtitle={{@subtitle}}
    @showOnlineIndicator={{@showOnlineIndicator}}
    @noPopover={{@noPopover}}
    @popoverPlacement={{@popoverPlacement}}
    @static={{@static}}
    @onClick={{@onClick}}
    @onView={{@onView}}
    @anchorClass={{@anchorClass}}
    @imageClass={{@imageClass}}
    @imageWrapperClass={{@imageWrapperClass}}
    @contentWrapperClass={{@contentWrapperClass}}
    @titleClass={{@titleClass}}
    @subtitleClass={{@subtitleClass}}
    @useBlock={{has-block}}
    ...attributes
    as |resource|
>
    {{yield resource}}
</Resource::Pill>
