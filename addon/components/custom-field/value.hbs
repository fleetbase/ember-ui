<div class="field-info-container {{if @customField.meta.colSpan (concat 'col-span-' @customField.meta.colSpan) ''}}">
    <div class="field-name">{{@customField.label}}</div>
    <div class="field-value">
        {{#if this.isBoolean}}
            <Badge @status={{if this.value "success" ""}}>{{if this.value "Yes" "No"}}</Badge>
        {{else if this.isFile}}
            <File @file={{this.value}} @onDownload={{this.downloadFile}} class="custom-field-file" />
        {{else if this.isSignature}}
            {{#if this.signatureUrl}}
                <img src={{this.signatureUrl}} alt="Signature" class="custom-field-signature-image" />
                {{#if this.canDownloadSignature}}
                    <a href="javascript:;" class="custom-field-signature-download text-xs text-blue-500 hover:text-blue-600 inline-flex items-center mt-1" {{on "click" this.downloadFile}}>
                        <FaIcon @icon="download" @size="sm" class="mr-1" />
                        Download
                    </a>
                {{/if}}
            {{else if this.value}}
                <File @file={{this.value}} @onDownload={{this.downloadFile}} class="custom-field-file" />
            {{else}}
                {{n-a this.value}}
            {{/if}}
        {{else}}
            {{n-a this.value}}
        {{/if}}
    </div>
</div>