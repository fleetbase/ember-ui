<Resource::Pill
    @resource={{this.resource}}
    @resourceType="user"
    @title={{@title}}
    @titleFallback={{or @titleFallback "No user"}}
    @subtitle={{this.subtitle}}
    @showOnlineIndicator={{this.showOnlineIndicator}}
    @online={{this.online}}
    @noPopover={{@noPopover}}
    @popoverPlacement={{@popoverPlacement}}
    @static={{@static}}
    @onClick={{@onClick}}
    @onView={{@onView}}
    @anchorClass={{@anchorClass}}
    @imageClass={{@imageClass}}
    @imageWrapperClass={{@imageWrapperClass}}
    @contentWrapperClass={{@contentWrapperClass}}
    @titleClass={{@titleClass}}
    @subtitleClass={{@subtitleClass}}
    @useBlock={{has-block}}
    ...attributes
    as |resource|
>
    {{yield resource}}
</Resource::Pill>
