{{yield}}
{{#if @onSearch}}
    <Input
        @type="text"
        @value={{@searchQuery}}
        aria-label={{t "common.search"}}
        placeholder={{or @searchPlaceholder (concat (t "common.search") " " (pluralize @title))}}
        class="w-64 form-input form-input-sm {{@searchInputClass}}"
        disabled={{@searchDisabled}}
        {{on "keyup" @onSearch}}
    />
{{/if}}
{{#if @onSubmitBulkSearch}}
    <BulkSearchDropdown @value={{@bulkSearchValue}} @onClear={{@onClearBulkSearch}} @onSubmit={{@onSubmitBulkSearch}} @placeholder={{@bulkSearchPlaceholder}} />
{{/if}}
{{#if @onReload}}
    <Button @icon="refresh" @onClick={{@onReload}} @helpText={{t "common.refresh"}} class={{@refreshButtonClass}} />
{{/if}}
<FiltersPicker
    @columns={{@columns}}
    @onApply={{fn this.filters.apply @controller}}
    @onClear={{fn this.filters.reset @controller}}
    @onFilterClear={{this.filters.clear}}
    @onChange={{this.filters.set}}
    @buttonWrapperClass={{@filterPickerButtonClass}}
    @gridCols={{@filterPickerGridCols}}
    @width={{@filterPickerWidth}}
    @size={{@filterPickerSize}}
    @iconOnly={{true}}
/>
{{#unless @hideColumnsPicker}}
    {{!-- There is nothing to pick when there are no columns, so the picker is withheld
        entirely rather than offering an empty list. --}}
    {{#if @columns}}
        <VisibleColumnPicker @columns={{@columns}} @onChange={{this.setColumns}} @iconOnly={{true}} @size={{@columnPickerSize}} class={{@columnPickerButtonClass}} />
    {{/if}}
{{/unless}}
{{#if (safe-has @table "selectedRows")}}
    <Layout::Resource::BulkActions @actions={{this.bulkActions}} @iconOnly={{@bulkActionIconOnly}} @buttonWrapperClass={{@bulkActionButtonClass}} />
{{/if}}
<Layout::Resource::ActionButtons @buttons={{this.actionButtons}} />
{{#if @onPressNew}}
    <Button @icon="plus" @iconPrefix="fas" @type="primary" @text={{t "common.new"}} class={{@newButtonClass}} @onClick={{@onPressNew}} />
{{/if}}
{{#if @onPressImport}}
    <Button @icon="upload" @type="magic" @text={{t "common.import"}} @wrapperClass="hidden md:flex" class={{@importButtonClass}} @onClick={{@onPressImport}} />
{{/if}}
{{#if @onPressExport}}
    <Button @icon="long-arrow-up" @iconClass="rotate-icon-45" @wrapperClass="hidden md:flex" @text={{t "common.export"}} class={{@exportButtonClass}} @onClick={{@onPressExport}} />
{{/if}}
{{#if (has-block "end")}}
    {{yield to="end"}}
{{/if}}
