<div class="fleetbase-pill {{unless this.isClickable 'fleetbase-pill--static'}}" ...attributes>
    {{#if this.isClickable}}
        <a href="javascript:;" class="fleetbase-pill-body flex flex-row space-x-2 {{@anchorClass}}" {{on "click" this.handleClick}}>
            <Pill::Body
                @resource={{@resource}}
                @resourceName={{this.resourceName}}
                @isOnline={{this.isOnline}}
                @hasImageBlock={{has-block "image"}}
                @hasDefaultBlock={{has-block}}
                @hasTooltipBlock={{has-block "tooltip"}}
                @imageSrc={{@imageSrc}}
                @imageFallback={{@imageFallback}}
                @fallbackImageType={{@fallbackImageType}}
                @imageSize={{@imageSize}}
                @imageWidth={{@imageWidth}}
                @imageHeight={{@imageHeight}}
                @imageAlt={{@imageAlt}}
                @imageClass={{@imageClass}}
                @imageWrapperClass={{@imageWrapperClass}}
                @showOnlineIndicator={{@showOnlineIndicator}}
                @onlineIndicatorClass={{@onlineIndicatorClass}}
                @contentWrapperClass={{@contentWrapperClass}}
                @title={{@title}}
                @titleFallback={{@titleFallback}}
                @titleClass={{@titleClass}}
                @subtitle={{@subtitle}}
                @subtitleClass={{@subtitleClass}}
                @noTooltip={{@noTooltip}}
                @tooltipPosition={{@tooltipPosition}}
                @tooltipComponent={{@tooltipComponent}}
            >
                <:image as |resource|>{{yield resource to="image"}}</:image>
                <:default as |resource|>{{yield resource}}</:default>
                <:tooltip as |resource|>{{yield resource to="tooltip"}}</:tooltip>
            </Pill::Body>
        </a>
    {{else}}
        <span class="fleetbase-pill-body flex flex-row space-x-2 {{@anchorClass}}" data-test-pill-static>
            <Pill::Body
                @resource={{@resource}}
                @resourceName={{this.resourceName}}
                @isOnline={{this.isOnline}}
                @hasImageBlock={{has-block "image"}}
                @hasDefaultBlock={{has-block}}
                @hasTooltipBlock={{has-block "tooltip"}}
                @imageSrc={{@imageSrc}}
                @imageFallback={{@imageFallback}}
                @fallbackImageType={{@fallbackImageType}}
                @imageSize={{@imageSize}}
                @imageWidth={{@imageWidth}}
                @imageHeight={{@imageHeight}}
                @imageAlt={{@imageAlt}}
                @imageClass={{@imageClass}}
                @imageWrapperClass={{@imageWrapperClass}}
                @showOnlineIndicator={{@showOnlineIndicator}}
                @onlineIndicatorClass={{@onlineIndicatorClass}}
                @contentWrapperClass={{@contentWrapperClass}}
                @title={{@title}}
                @titleFallback={{@titleFallback}}
                @titleClass={{@titleClass}}
                @subtitle={{@subtitle}}
                @subtitleClass={{@subtitleClass}}
                @noTooltip={{@noTooltip}}
                @tooltipPosition={{@tooltipPosition}}
                @tooltipComponent={{@tooltipComponent}}
            >
                <:image as |resource|>{{yield resource to="image"}}</:image>
                <:default as |resource|>{{yield resource}}</:default>
                <:tooltip as |resource|>{{yield resource to="tooltip"}}</:tooltip>
            </Pill::Body>
        </span>
    {{/if}}
</div>
