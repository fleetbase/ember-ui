<div class="date-picker-container">
    <input
        type="text"
        value={{this.displayValue}}
        placeholder={{@placeholder}}
        autocomplete="off"
        class="fleetbase-date-picker form-input {{@class}}"
        ...attributes
        {{did-insert this.setupComponent}}
        {{did-update this.syncValue @value}}
        {{on "change" this.handleTypedValue}}
    />
</div>