{{! ComboBox example adapter. }}
<ComboBox
    @options={{this.options}}
    @selected={{this.selected}}
    @optionLabel={{@values.optionLabel}}
    @selectionBoxLabel={{@values.selectionBoxLabel}}
    @optionBoxLabel={{@values.optionBoxLabel}}
    @icon={{@values.icon}}
    @onChange={{this.select}}
/>
