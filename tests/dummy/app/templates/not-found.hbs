{{page-title "Not found"}}

<section class="pg-notfound" data-test-not-found>
    <p class="pg-notfound__eyebrow">Not in the playground</p>
    <h1 class="pg-notfound__title">This component has no interactive page</h1>
    <p class="pg-notfound__body">
        The playground covers only the components documented at
        <a href="https://fleetbase.io/docs/ui">fleetbase.io/docs/ui</a>. The addon exports many more
        public components; they are intentionally not given pages here.
    </p>
    <LinkTo @route="components" class="pg-btn pg-btn--primary" data-test-back-to-catalog>Back to the catalog</LinkTo>
</section>
